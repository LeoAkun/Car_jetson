Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: base_link
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Value: /pothole_markers
      Name: Pothole Markers
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Decay Time: 1
      Enabled: true
      Name: Pothole Detections
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.04
      Style: Flat Squares
      Topic:
        Value: /pothole_detections
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Height Diff Image
      Topic:
        Value: /height_map/depth_diff_image
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Pothole Mask Image
      Topic:
        Value: /height_map/pothole_mask
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Pothole Candidate Mask
      Topic:
        Value: /height_map/pothole_candidate_mask
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Pothole Rejection Debug
      Topic:
        Value: /height_map/pothole_rejection_debug
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Pit Bottom Mask
      Topic:
        Value: /height_map/pit_bottom_mask
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Negative Edge Mask
      Topic:
        Value: /height_map/negative_edge_mask
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Unknown Hole Mask
      Topic:
        Value: /height_map/unknown_hole_mask
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Ground Like Mask
      Topic:
        Value: /height_map/ground_like_mask
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0.8
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.65
      Target Frame: base_link
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
