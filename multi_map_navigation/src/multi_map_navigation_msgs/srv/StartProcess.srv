# 启动进程服务
string process_name  # 要启动的进程名称: re_localization, nav2_init_pose, liosam, navigation2
string map_name      # 地图名称（用于re_localization和navigation2）
bool use_initial_pose  # 地图切换时使用切换点在新地图中的先验位姿
geometry_msgs/PoseStamped initial_pose
---
bool success         # 启动成功返回true，否则返回false
bool busy            # 其他启动事务正在处理；调用方不得据此清理导航栈
string message       # 错误或状态消息
string instance_id   # 本轮定位会话ID；非定位进程为空
string active_map    # 该进程绑定的地图
int64 session_start_ns  # 本轮定位会话开始时间
