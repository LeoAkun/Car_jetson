[Unit]
Description=CarJetson field navigation reboot and thermal monitor
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/akun/workspace/Car_jetson
ExecStart=/usr/bin/python3 /home/akun/workspace/Car_jetson/thermal_testing/idle_crash_monitor.py --duration 86400 --interval 1 --label nav_field_test
Restart=always
RestartSec=5
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
